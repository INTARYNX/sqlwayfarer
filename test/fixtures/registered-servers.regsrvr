                    <RegisteredServers:ConnectionStringWithEncryptedPassword>data source="tcp:erp-sql\PROD,14330";initial catalog=Erp;user id=svc_read;password=AQAAANCMnd8BFdERjHoAwE;encrypt=True;trustservercertificate=False</RegisteredServers:ConnectionStringWithEncryptedPassword>
