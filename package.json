{
  "name": "sqlwayfarer",
  "displayName": "SQL Wayfarer",
  "description": "A SQL Server & Azure SQL workspace for VS Code: see what depends on a column, trace the tables a procedure really touches through triggers, edit and run T-SQL across multiple files with execution plans, generate scripts, and export a Markdown data dictionary.",
  "version": "0.12.9",
  "publisher": "intarynx",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Visualization",
    "Data Science",
    "Other"
  ],
  "keywords": [
    "sql server",
    "azure sql",
    "tsql",
    "mssql",
    "database",
    "data dictionary",
    "column lineage",
    "dependency graph",
    "query graph",
    "join graph",
    "dependencies",
    "schema",
    "explorer",
    "erd",
    "trigger",
    "procedure",
    "table",
    "query",
    "ssms",
    "sql server management studio",
    "data lineage",
    "impact analysis",
    "stored procedure",
    "execution plan",
    "sql explorer",
    "intellisense",
    "dba",
    "database documentation",
    "table footprint",
    "database diagram",
    "column dependencies",
    "sql client",
    "legacy database",
    "legacy sql",
    "existing database",
    "unknown schema",
    "database reverse engineering",
    "schema audit",
    "database refactoring",
    "technical debt",
    "brownfield",
    "migration impact",
    "change impact",
    "sql documentation",
    "sql server tools"
  ],
  "galleryBanner": {
    "color": "#0E2A3F",
    "theme": "dark",
    "path": "images/banner.png"
  },
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/intarynx/sqlwayfarer.git"
  },
  "bugs": {
    "url": "https://github.com/intarynx/sqlwayfarer/issues"
  },
  "homepage": "https://github.com/intarynx/sqlwayfarer",
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sqlwayfarer.sqlwayfarer",
        "title": "Open SQL Wayfarer",
        "icon": "$(compass)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sql-wayfarer-container",
          "title": "SQL Wayfarer",
          "icon": "$(compass)"
        }
      ]
    },
    "views": {
      "sql-wayfarer-container": [
        {
          "id": "sqlWayfarerView",
          "name": "SQL Wayfarer",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "sqlwayfarer.sqlwayfarer",
          "when": "view == sqlWayfarerView",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "webpack",
    "lint": "eslint .",
    "test": "vscode-test",
    "package": "npm run build && vsce package",
    "publish": "npm run build && vsce publish"
  },
  "dependencies": {
    "antlr4": "^4.13.2",
    "mssql": "^10.0.1",
    "piscina": "^5.3.2"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.100.0",
    "@vscode/codicons": "^0.0.45",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2",
    "codemirror": "^6.0.2",
    "cytoscape": "^3.34.0",
    "cytoscape-dagre": "^4.0.0",
    "dagre": "^0.8.5",
    "eslint": "^9.25.1",
    "typescript": "^5.1.6",
    "webpack": "^5.107.2",
    "webpack-cli": "^5.1.4"
  }
}
