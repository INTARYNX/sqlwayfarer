# Everything excluded by default — only what's needed for the packaged extension is kept

# Source files (bundled into dist/)
database/**
panels/**
storage/**
src/**
extension.js

# Dependencies (bundled into dist/)
node_modules/**

# Build tooling
webpack.config.js
package-lock.json
deploy.ps1
commit.ps1
.vscode-test.mjs
.mocharc.json
eslint.config.mjs
jsconfig.json
tsconfig.json
.eslintrc*
vsc-extension-quickstart.md
scripts/**

# The sources of the editor bundle: only dist/webview/sqlEditor.js is loaded
webview-build/**

# Scratch/dev files that don't belong in the published package
fix_sqlerrm.sql
large_db_test.sql
REVIEW.md
EDITOR_EVALUATION.md
AGENTS.md
.claude/**

# Project assets, not extension assets
images/**

# Dev/CI
.vscode/**
.git/**
.gitignore
.github/**
test/**
coverage/
.nyc_output/
*.log
*.tmp
.cache/
.env
.env.local
.DS_Store
Thumbs.db

# Windows authentication helper: only the compiled program ships
helper/**

# Keep these
!helper/SqlWayfarerSspi.exe
!dist/extension.js
!dist/parseColumnsWorker.js
!dist/webview/sqlEditor.js
!dist/webview/graphLibs.js
!dist/webview/graphLibs.js.LICENSE.txt
!dist/webview/vendor/**
!icon.png
!images/banner.png
!package.json
!README.md
!LICENSE
!THIRD_PARTY_NOTICES.md

# piscina has no runtime dependencies of its own, but it resolves its worker
# bootstrap script relative to its own package folder at runtime (not bundled
# by webpack - see webpack.config.js externals), so it must ship as-is.
!node_modules/piscina/**
